generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default(cuid())
  phone          String?
  instagram      String?
  telegram       String?
  email          String?
  address        String?
  workingHours   String?
  footerText     String?
  heroTitle      String?
  heroSubtitle   String?
  heroCtaText    String?
  heroCtaSecond  String?
  aboutTitle     String?
  aboutSubtitle  String?
  aboutText      String?
  aboutImage     String?
  contactTitle   String?
  contactText    String?
  updatedAt      DateTime @updatedAt
}

model Statistic {
  id        String   @id @default(cuid())
  label     String
  value     Int
  suffix    String?  // "+", "%", ""
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  number      Int
  icon        String?
  title       String
  description String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  order    Int       @default(0)
  active   Boolean   @default(true)
  projects Project[]
}

model Project {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  categoryId       String
  category         ProjectCategory  @relation(fields: [categoryId], references: [id])
  mainImage        String
  shortDescription String
  fullDescription  String?          @db.Text
  result           String?
  resultNumber     String?
  duration         String?
  audience         String?
  instagramUrl     String?
  websiteUrl       String?
  order            Int              @default(0)
  featured         Boolean          @default(false)
  active           Boolean          @default(true)
  images           ProjectImage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model TeamMember {
  id         String   @id @default(cuid())
  fullName   String
  position   String
  experience String?
  photo      String?
  instagram  String?
  linkedin   String?
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  COMPLETED
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  phone     String
  instagram String?
  message   String?    @db.Text
  status    LeadStatus @default(NEW)
  isRead    Boolean    @default(false)
  createdAt DateTime   @default(now())
}
